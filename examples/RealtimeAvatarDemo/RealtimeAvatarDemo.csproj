<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);CS3001;CS3002;CS3003;CA1819;CA1031</NoWarn>
  </PropertyGroup>

  <!-- Project references to sibling SDK repos in the tryAGI workspace -->
  <ItemGroup>
    <ProjectReference Include="../../../DId/src/libs/DId/DId.csproj">
      <Aliases>DIdSdk</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../../Simli/src/libs/Simli/Simli.csproj">
      <Aliases>SimliSdk</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../../AvatarTalk/src/libs/AvatarTalk/AvatarTalk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.3" />
  </ItemGroup>

</Project>
